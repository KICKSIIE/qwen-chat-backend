# --- Required ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- Ollama ---
OLLAMA_URL=
MODEL_NAME=qwen2.5:7b
MAX_HISTORY_MESSAGES=12

# --- Email (Gmail SMTP) ---
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16 characters below (spaces are ignored)
# If SMTP_USER / SMTP_PASS are empty and NODE_ENV is not "production",
# codes are printed in the server console instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="

# --- Optional ---
PORT=3000
# Only needed if you serve a web build (native apps ignore CORS). Comma-separated.
# CORS_ORIGIN=http://localhost:8081
# NODE_ENV=production
